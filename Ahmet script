local isDragging = false
local dragStart = nil
local startPos = nil

local mainAnimation = nil
local animTrack = nil
local staticTrusses = {}

local function setupStaticTrusses()
    staticTrusses = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TrussPart") or (obj:IsA("BasePart") and string.find(string.lower(obj.Name), "truss")) then
            table.insert(staticTrusses, obj)
        end
    end
end
setupStaticTrusses()

local function setupAnimation(humanoid)
    if animTrack then 
        animTrack:Stop()
        animTrack:Destroy()
        animTrack = nil
    end
    if mainAnimation then 
        mainAnimation:Destroy() 
    end
    
    mainAnimation = Instance.new("Animation")
    mainAnimation.AnimationId = EMO_ANIMATION_ID
    
    local success, _ = pcall(function()
        animTrack = humanoid:LoadAnimation(mainAnimation)
    end)
    if not success then
        animTrack = nil
    end
end

