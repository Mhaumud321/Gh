local function getNearestEnemy()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    
    local nearest, minDist = nil, 200
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
            if plr.Team == nil or plr.Team ~= LocalPlayer.Team then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (hrp.Position - myRoot.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = hrp
                    end
                end
            end
        end
    end
    return nearest
end

RunService.Heartbeat:Connect(function()
    if not enemyEnabled or enemyTouchingMove then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local target = getNearestEnemy()
    
    if hum and hrp and target then
        hum:MoveTo(target.Position)
        if target.Position.Y > hrp.Position.Y + 3 then hum.Jump = true end
    end
end)

